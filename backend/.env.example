# ---- Core -------------------------------------------------------------------
# production refuses to start with the default SECRET_KEY
ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please
# postgresql+psycopg2://user:pass@host/db | mysql+pymysql://user:pass@host/db
DATABASE_URL=sqlite:///./data/mcq.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# true behind nginx / a load balancer (uses X-Forwarded-For for IP rules)
TRUST_PROXY=false

# ---- Sign-in ----------------------------------------------------------------
# true = really send OTP emails via SMTP; false = print OTP to the server console
ALLOW_SEND_EMAIL=false
# DEVELOPMENT ONLY: also show the OTP on the login page. Never enable in production.
DEV_SHOW_OTP=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password-or-app-password
FROM_EMAIL=your-email@gmail.com
# false = only pre-registered / bulk-uploaded students can sign in
ALLOW_SELF_REGISTRATION=true
# false = students must use password (+ OTP if MFA) or Google/Microsoft
ALLOW_OTP_ONLY_LOGIN=true
# roles that may only be signed in on one device at a time
SINGLE_SESSION_ROLES=student
# creates teacher@example.com, student@example.com and a demo exam on first run
SEED_DEV_USERS=true
ADMIN_EMAIL=admin@example.com
# change it! (needs 8+ chars, uppercase and digit)
ADMIN_PASSWORD=Admin@12345
# enables "Continue with Google"
GOOGLE_CLIENT_ID=
# enables "Continue with Microsoft" (redirect URI: <your-site>/ms-callback.html)
MICROSOFT_CLIENT_ID=
# or your tenant id to restrict to your organisation
MICROSOFT_TENANT=common

# ---- Exam behaviour ---------------------------------------------------------
# max time given back to a student per attempt after connection drops
OFFLINE_CREDIT_CAP_SECONDS=600
SUBMIT_GRACE_SECONDS=5

# ---- Storage (snapshots, question images) ----------------------------------
# local | s3 | azure | gcs
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3_BUCKET=  S3_REGION=  S3_ENDPOINT_URL=        (AWS credentials from the environment / IAM role)
# AZURE_STORAGE_CONNECTION_STRING=  AZURE_CONTAINER=mcq
# GCS_BUCKET=                                       (GOOGLE_APPLICATION_CREDENTIALS from the environment)

# ---- Scale-out --------------------------------------------------------------
# redis://redis:6379/0  needed when running several backend replicas
REDIS_URL=
# optional: mirror proctoring events to MongoDB
MONGO_URL=
MONGO_DB=mcq
